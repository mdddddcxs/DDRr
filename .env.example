# ---------------------------------------------------------------
# Variables PUBLIQUES (visibles dans le navigateur, c'est normal)
# Supabase > Project Settings > API
# ---------------------------------------------------------------
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# Variables SECRÈTES (uniquement côté serveur, dans Vercel)
# Ne jamais les préfixer par VITE_ et ne jamais les commiter.
# ---------------------------------------------------------------
# Google AI Studio : clé pour le Compagnon DDR (texte + voix)
GEMINI_API_KEY=
# Facultatif : modèles utilisés
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_LIVE_MODEL=gemini-3.8-live

# Google Cloud : clé YouTube Data API v3 (restreinte à cette API)
YOUTUBE_API_KEY=
# Chaîne YouTube de la DDR (sans @), ou son identifiant UC...
YOUTUBE_CHANNEL_HANDLE=ddrofficielle
# YOUTUBE_CHANNEL_ID=

# Facultatif : autres domaines autorisés à appeler /api (séparés par des virgules)
# ALLOWED_ORIGINS=https://laddr.ci
